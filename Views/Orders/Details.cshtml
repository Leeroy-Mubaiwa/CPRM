@model CPRM.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<style>
    @@media print {
        .d-print-none {
            display: none !important;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
        }
        .table-bordered {
            border: 1px solid #dee2e6 !important;
        }
        .table-bordered th,
        .table-bordered td {
            border: 1px solid #dee2e6 !important;
        }
    }
</style>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Order Details</h1>
        <div class="btn-group d-print-none">
            <a asp-action="Edit" asp-route-id="@Model?.OrderId" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit Order
            </a>
            <button onclick="window.print()" class="btn btn-outline-secondary">
                <i class="bi bi-printer"></i> Print
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h5 class="text-primary mb-3">Order Information</h5>
                    <table class="table table-borderless">
                        <tr>
                            <th class="w-25">Order ID:</th>
                            <td>@Model.OrderId</td>
                        </tr>
                        <tr>
                            <th>Order Date:</th>
                            <td>@Model.OrderDate?.ToString("MMMM dd, yyyy")</td>
                        </tr>
                        <tr>
                            <th>Status:</th>
                            <td>
                                <span class="badge @(Model.Status == "Completed" ? "bg-success" : 
                                                    Model.Status == "Processing" ? "bg-warning" :
                                                    Model.Status == "Cancelled" ? "bg-danger" : "bg-info")">
                                    @Model.Status
                                </span>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="col-md-6">
                    <h5 class="text-primary mb-3">Partner Information</h5>
                    <table class="table table-borderless">
                        <tr>
                            <th class="w-25">Partner ID:</th>
                            <td>@Model.Partner?.PartnerId</td>
                        </tr>
                        <tr>
                            <th>Name:</th>
                            <td>@Model.Partner?.FullName</td>
                        </tr>
                        <tr>
                            <th>Email:</th>
                            <td>@Model.Partner?.Email</td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="table-responsive mb-4">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td>@item.Product?.ProductName</td>
                                <td class="text-end">@item.Quantity</td>
                                <td class="text-end">@item.UnitPrice?.ToString("C")</td>
                                <td class="text-end">@((item.Quantity * item.UnitPrice)?.ToString("C"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="3" class="text-end">Total Amount:</th>
                            <th class="text-end">@Model.TotalAmount?.ToString("C")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="card-title">Notes</h6>
                            <p class="card-text text-muted">No additional notes for this order.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="card-title">Payment Information</h6>
                            <p class="card-text text-muted">Payment status will be updated here.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
