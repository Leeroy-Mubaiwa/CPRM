@model CPRM.Models.Order

@{
    ViewData["Title"] = "Create Order";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Create New Order</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">Order Items</h5>
                </div>
                <div class="card-body">
                    <div id="orderItems">
                        <div class="order-item mb-3">
                            <div class="row g-3">
                                <div class="col-md-5">
                                    <label class="form-label">Product</label>
                                    <select class="form-select product-select" name="OrderItems[0].ProductId">
                                        <option value="">Select a product</option>
                                        @foreach (var product in ViewBag.Products)
                                        {
                                            <option value="@product.ProductId" data-price="@product.Price">
                                                @product.ProductName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Quantity</label>
                                    <input type="number" class="form-control quantity" name="OrderItems[0].Quantity"
                                        min="1" value="1">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Unit Price</label>
                                    <input type="text" class="form-control unit-price" name="OrderItems[0].UnitPrice" readonly>
                                </div>
                                <div class="col-md-1 d-flex align-items-end">
                                    <button type="button" class="btn btn-outline-danger remove-item"
                                        style="display: none;">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-primary mt-3" id="addItem">
                        <i class="bi bi-plus-circle"></i> Add Item
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">Order Details</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="PartnerId" class="form-label"></label>
                            <select asp-for="PartnerId" class="form-select" asp-items="ViewBag.PartnerId">
                                <option value="">Select a partner</option>
                            </select>
                            <span asp-validation-for="PartnerId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OrderDate" class="form-label"></label>
                            <input asp-for="OrderDate" class="form-control" type="datetime-local">
                            <span asp-validation-for="OrderDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Pending">Pending</option>
                                <option value="Processing">Processing</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TotalAmount" class="form-label"></label>
                            <input asp-for="TotalAmount" class="form-control" readonly>
                            <span asp-validation-for="TotalAmount" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Create Order
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let itemCount = 1;

            // Add new order item
            $('#addItem').on('click', function () {
                const newItem = $('.order-item:first').clone();
                newItem.find('select').val('');
                newItem.find('input').val('');
                newItem.find('.remove-item').show();

                // Update all input and select names with new index
                newItem.find('select, input').each(function () {
                    const name = $(this).attr('name');
                    if (name) {
                        $(this).attr('name', name.replace('[0]', '[' + itemCount + ']'));
                    }
                });

                // Clear any existing values
                newItem.find('.product-select').val('');
                newItem.find('.quantity').val('1');
                newItem.find('.unit-price').val('');

                $('#orderItems').append(newItem);
                itemCount++;
            });

            // Remove order item
            $(document).on('click', '.remove-item', function () {
                $(this).closest('.order-item').remove();
                calculateTotal();
            });

            // Update unit price when product is selected
            $(document).on('change', '.product-select', function () {
                const selectedOption = $(this).find('option:selected');
                const price = selectedOption.data('price');
                const unitPriceInput = $(this).closest('.order-item').find('.unit-price');
                unitPriceInput.val(price ? price.toFixed(2) : '');
                calculateTotal();
            });

            // Calculate total when quantity changes
            $(document).on('input', '.quantity', function () {
                calculateTotal();
            });

            // Calculate total amount
            function calculateTotal() {
                let total = 0;
                $('.order-item').each(function () {
                    const quantity = parseFloat($(this).find('.quantity').val()) || 0;
                    const unitPrice = parseFloat($(this).find('.unit-price').val()) || 0;
                    total += quantity * unitPrice;
                });
                $('#TotalAmount').val(total.toFixed(2));
            }

            // Initialize
            calculateTotal();
        });
    </script>
}
